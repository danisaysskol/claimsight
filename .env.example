# ClaimSight environment configuration.
# Copy this file to `.env` and adjust values. `.env` is gitignored — never commit real secrets.

# --- PostgreSQL connection (matches docker-compose.yml) ---
POSTGRES_USER=claimsight
POSTGRES_PASSWORD=claimsight
POSTGRES_DB=claimsight
POSTGRES_HOST=localhost
# Host port. docker-compose maps this to the container's 5432.
POSTGRES_PORT=5433

# --- Application settings ---
# Random seed for reproducible synthetic data generation.
CLAIMSIGHT_SEED=42
# Target number of claim lines to generate.
CLAIMSIGHT_N_CLAIM_LINES=60000
# Schema names.
RAW_SCHEMA=raw
REPORTING_SCHEMA=reporting

# --- Data quality gate ---
# If true, a CRITICAL-severity DQ rule failure exits the pipeline non-zero.
DQ_FAIL_ON_CRITICAL=true
